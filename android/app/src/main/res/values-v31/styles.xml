<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ system SplashScreen API.
      Without windowSplashScreenIconBackgroundColor, the OS draws the launcher
      icon on a WHITE circular disc — the broken CueLift splash the user saw.
      Navy icon + splash backgrounds make the circle invisible (continuous field).
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/cuelift_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/cuelift_navy</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/cuelift_navy</item>
    </style>
</resources>
