<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same CueLift navy splash in OS dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/cuelift_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/cuelift_navy</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/cuelift_navy</item>
    </style>
</resources>
